# ─────────────────────────────────────────────────────────────────────────────
# Aqdi (عقدي) customer website — environment template
# Copy this file to `.env.local` (local dev) and set the same keys in your host
# (e.g. Vercel → Project → Settings → Environment Variables) for production.
# Every variable here is a NEXT_PUBLIC_* value — it is inlined into the browser
# bundle at BUILD time, so you must rebuild/redeploy after changing any of them.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Laravel backend API (include the /api/v2 path, no trailing slash).
# Local dev points at the local Laravel; production must point at the live API.
NEXT_PUBLIC_BASE_URL=https://api.your-domain.com/api/v2

# Firebase Web App API key (Firebase console → Project settings → General → Your apps → Web app → SDK setup).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key

# Firebase Auth domain, e.g. your-project.firebaseapp.com (same SDK config block).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase project id, e.g. your-project (same SDK config block).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project

# Firebase storage bucket, e.g. your-project.appspot.com (same SDK config block).
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase Cloud Messaging sender id (numeric) (same SDK config block).
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000

# Firebase Web App id, e.g. 1:000000000000:web:abcdef (same SDK config block).
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef0123456789

# Optional: Google Analytics measurement id, e.g. G-XXXXXXXXXX (only if Analytics is enabled).
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Web Push (FCM) VAPID public key for browser push notifications
# (Firebase console → Project settings → Cloud Messaging → Web configuration → Web Push certificates → Key pair).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY secrets — used by the /api/order route (Telegram order intake).
# NOT NEXT_PUBLIC: never sent to the browser. Do NOT add a NEXT_PUBLIC_ prefix.
# Set in .env.local (local) and in your host's server-side env vars for production.
# ─────────────────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather (looks like 123456789:AA...). Keep it secret.
TELEGRAM_BOT_TOKEN=

# Chat id that receives new orders (your Telegram user id, or a group/channel id).
# Find it: message your bot, open https://api.telegram.org/bot<TOKEN>/getUpdates,
# then read result[].message.chat.id (group ids are negative, e.g. -1001234567890).
TELEGRAM_CHAT_ID=
